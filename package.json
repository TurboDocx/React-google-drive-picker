{
  "name": "@turbodocx/react-google-drive-picker",
  "version": "1.2.3",
  "description": "React google drive picker api",
  "types": "./dist",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsrs --noEmit -p tsconfig.typecheck.json --checkers 4",
    "watch": "tsc -w",
    "dev": "nodemon ./dist/index.js",
    "lint": "node scripts/oxlint-baseline.mjs --check --fast",
    "lint:fix": "oxlint --fix -A all src demo/src",
    "lint:ci": "node scripts/oxlint-baseline.mjs --check",
    "lint:baseline": "node scripts/oxlint-baseline.mjs",
    "format": "prettier --write ./src/*"
  },
  "author": "TurboDocx",
  "contributors": [
    "Jose-cd",
    "nicolasiscoding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TurboDocx/React-google-drive-picker.git"
  },
  "bugs": {
    "url": "https://github.com/TurboDocx/React-google-drive-picker/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "google",
    "drive",
    "picker"
  ],
  "devDependencies": {
    "@types/react": "^17.0.5",
    "nodemon": "^2.0.7",
    "oxlint": "1.89.0",
    "prettier": "2.3.2",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "typescript": "^4.2.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.19.0",
      "onFail": "warn"
    }
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  }
}
